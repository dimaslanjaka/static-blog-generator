{
  "$schema": "https://opencode.ai/config.json",
  "model": "anthropic/claude-sonnet-4-5",
  "autoupdate": true,
  "instructions": [
    "AGENTS.md",
    ".github/instructions/*.md",
    ".github/instructions/*.instructions.md",
    ".cursor/rules/*.md",
    "docs/rules/*.md",
    "docs/*.md",
  ],
  "plugin": ["opencode-agent-memory@https://github.com/dimaslanjaka/opencode-file-memory/raw/refs/heads/main/release/opencode-agent-memory.tgz"],
  "server": {
    "port": 4096
  }
}
