{
  "name": "sbg-utility",
  "version": "2.0.10",
  "description": "static-blog-generator utility",
  "keywords": [
    "static-blog-generator",
    "utility"
  ],
  "homepage": "https://github.com/dimaslanjaka/static-blog-generator#readme",
  "bugs": {
    "url": "https://github.com/dimaslanjaka/static-blog-generator/issues"
  },
  "license": "MIT",
  "author": "Dimas Lanjaka <dimaslanjaka@gmail.com> (https://www.webmanajemen.com)",
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "require": {
        "default": "./dist/index.cjs",
        "types": "./dist/index.d.cts"
      },
      "import": {
        "default": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "dist/node_modules/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dimaslanjaka/static-blog-generator.git"
  },
  "scripts": {
    "prepublish": "npm run clean && npm run build",
    "update:ncu": "npx npm-check-updates -u",
    "update": "run-s \"update:**\"",
    "pretest": "node --no-warnings --experimental-specifier-resolution=node --loader ts-node/esm -r dotenv/config jest.setup.ts",
    "test": "cross-env-shell NODE_OPTIONS=\"--experimental-vm-modules\" jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "npm test -- --coverage",
    "lint": "eslint \"src/**/*.ts\" --fix",
    "build": "gulp --series populate-config build",
    "rollup": "node --max-old-space-size=4096 ./node_modules/rollup/dist/bin/rollup -c -m",
    "clean": "rimraf dist tmp",
    "pack": "node packer.cjs --yarn"
  },
