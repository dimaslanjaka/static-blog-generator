{
  "name": "static-blog-generator-root",
  "version": "3.0.1",
  "description": "Pre-processing of all source posts/articles before rendering using hexo. Useful for low-end devices to avoid memory heap errors. With this package you can prevent using a large number of hexo plugins, because some functions (runners) are separated by task, so they are memory friendly.",
  "private": true,
  "files": [
    "packages/sbg-*/dist/**/*",
    "packages/sbg-*/package.json",
    "LICENSE",
    "*.json",
    "!dist/**/*",
    "!**/node_modules/**",
    "!packages/**/node_modules/**",
    "!**/tmp/**",
    "!packages/**/tmp/**",
    "!test",
    "!**/test/**",
    "!**/src/**"
  ],
  "scripts": {
    "start": "yarn build && yarn workspace sbg-site-test run start",
    "update:ncu": "npm-check-updates -u -x chalk,codemirror,highlight.js,hexo && yarn workspaces foreach --worktree run update:ncu",
    "update:packer": "yarn workspaces foreach --worktree run update:packer",
    "update": "run-s \"update:**\"",
    "docs": "node docs.js",
    "lint": "yarn workspaces run lint",
    "test": "jest --coverage --runInBand --detectOpenHandles",
    "test-serve": "node jest.serve.js",
    "build-util": "node build.mjs sbg-utility --build",
    "build-api": "node build.mjs sbg-api --build",
    "build-server": "node build.mjs sbg-server --build",
    "build-cli": "node build.mjs sbg-cli --build",
    "build": "run-s \"build-**\" && yarn workspaces foreach --worktree --no-private --exclude sbg-utility --exclude sbg-api --exclude sbg-server --exclude sbg-cli run build",
    "clean-util": "yarn workspace sbg-utility run clean",
    "clean-api": "yarn workspace sbg-api run clean",
    "clean-server": "yarn workspace sbg-server run clean",
    "clean-cli": "yarn workspace sbg-cli run clean",
    "clean": "run-s \"clean-**\" && yarn workspaces foreach --worktree --no-private run clean",
    "pack": "yarn workspaces foreach --all --no-private exec \"npm run pack --if-present -- --commit\"",
    "prepare": "husky"
  },
  "author": "Dimas Lanjaka <dimaslanjaka@gmail.com> (https://webmanajemen.com)",
  "license": "MIT",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/preset-env": "^7.29.5",
    "@babel/preset-typescript": "^7.28.5",
    "@commitlint/cli": "^21.0.1",
    "@commitlint/config-conventional": "^21.0.1",
    "@eslint/eslintrc": "3.3.5",
    "@eslint/js": "9",
    "@jest/globals": "^30.4.1",
    "@types/gulp": "^4.0.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.8.0",
    "@types/through2": "https://github.com/dimaslanjaka/nodejs-package-types/raw/through2/release/types-through2.tgz",
    "@typescript-eslint/eslint-plugin": "^8.59.3",
    "@typescript-eslint/parser": "^8.59.3",
    "babel-jest": "^30.4.1",
    "binary-collections": "^2.0.11",
    "depcheck": "^1.4.7",
    "eslint": "9",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-cli": "^3.1.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-config": "^30.4.2",
    "jest-html-reporters": "^3.1.7",
    "jsonc-parser": "3.3.1",
    "lint-staged": "^17.0.5",
    "nodemon": "^3.1.14",
    "npm-check-updates": "^22.2.0",
    "npm-run-all": "^4.1.5",
    "prettier": "3.8.3",
    "rimraf": "^6.1.3",
    "rollup": "^4.60.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.59.3",
    "typescript-transform-paths": "^3.5.6",
    "upath": "^3.0.7"
  },
  "workspaces": [
    "packages/*",
    "test"
  ],
  "packageManager": "yarn@4.13.0",
  "engines": {
    "node": ">=16"
  },
  "peerDependenciesMeta": {
    "markdown-it-anchor": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "resolutions": {
    "binary-collections": "https://github.com/dimaslanjaka/bin/raw/fa22222449a7b264007b326bc66007413dba1d4a/releases/bin.tgz",
    "hexo-renderers": "https://github.com/dimaslanjaka/hexo-renderers/raw/87e0c2c3fbcd588fdcec75a59dbca31f9d913e4b/release/hexo-renderers.tgz",
    "hexo-shortcodes": "https://github.com/dimaslanjaka/hexo-shortcodes/raw/2ed1250d701369b8235a02b9af834bbfc62644a0/release/hexo-shortcodes.tgz",
    "cross-spawn": "https://github.com/dimaslanjaka/node-cross-spawn/raw/78b09a1f799430fb251c1b438ec56ce7957674f4/release/cross-spawn.tgz",
    "@dimaslanjaka/eslint-base-config": "https://github.com/dimaslanjaka/eslint-base-config/raw/69ca996fdeaac42c93dd590124996eff58b5d6c2/release/dimaslanjaka-eslint-base-config.tgz"
  }
}
